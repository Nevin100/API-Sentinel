{"panels": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}}, "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "id": 1, "targets": [{"expr": "sum(sentinel_endpoint_up)", "refId": "A"}], "title": "Endpoints Up", "type": "stat"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}, "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "id": 2, "targets": [{"expr": "count(sentinel_endpoint_up == 0) or vector(0)", "refId": "A"}], "title": "Endpoints Down", "type": "stat"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "id": 3, "targets": [{"expr": "sum(increase(sentinel_checks_total[5m]))", "refId": "A"}], "title": "Checks (last 5m)", "type": "stat"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "id": 4, "targets": [{"expr": "sentinel_requests_sent_total", "refId": "A"}], "title": "Tester Requests Sent", "type": "stat"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10}, "unit": "s"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "id": 5, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(sentinel_check_latency_seconds_bucket[5m])) by (endpoint_id, le))", "legendFormat": "endpoint {{endpoint_id}}", "refId": "A"}], "title": "Check Latency p95 (per endpoint)", "type": "timeseries"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "id": 6, "targets": [{"expr": "sum(rate(sentinel_checks_total[5m])) by (ok)", "legendFormat": "ok={{ok}}", "refId": "A"}], "title": "Checks per Second (by result)", "type": "timeseries"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10}, "unit": "percent"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "id": 7, "targets": [{"expr": "docker_container_cpu_percent", "legendFormat": "{{name}}", "refId": "A"}], "title": "Container CPU % (per service)", "type": "timeseries"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10}, "unit": "bytes"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "id": 8, "targets": [{"expr": "docker_container_memory_bytes", "legendFormat": "{{name}}", "refId": "A"}], "title": "Container Memory (per service)", "type": "timeseries"}], "refresh": "10s", "schemaVersion": 39, "time": {"from": "now-1h", "to": "now"}, "title": "API Sentinel", "uid": "api-sentinel", "version": 1}