# VM pe ".env" naam se rakho (repo me kabhi commit mat karna).
# Har <...> wali value VM pe generate/bhar lena.

# Postgres (compose service name — localhost NAHI)
DATABASE_URL=postgresql://sentinel:sentinel@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0

# VM pe chalao: openssl rand -hex 32
JWT_SECRET=<openssl-rand-hex-32-ka-output>

# Prod = HTTPS, isliye true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Sirf Vercel wala frontend
CORS_ORIGINS=https://sentinel.nevinbali.me

# Discord alerts (optional — baad me daal sakte ho)
ALERT_WEBHOOK_URL=
ALERT_THRESHOLD=2

# Monitoring check interval (seconds)
CHECK_INTERVAL_SECONDS=300
